# Copy this file to .env.local  (it is NOT in the zip). No spaces, no quotes around values.
# Restart "npm run dev" after every change.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Google AI Studio -> Get API key
GEMINI_API_KEY=your-gemini-key
# Model names change often. Open /setup-check to see which names your key can use; if one shows PROBLEM, try another from the list.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Free-tier protection (optional, these are the defaults)
GEMINI_DAILY_CAP=800
